# ---- Model rewriting (optional) ----
# The offline rules engine needs none of this. Set ONE of these keys to turn on
# model rewriting; whichever key is present decides the provider.

# Gemini. Get a key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Claude, if you would rather: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=

# Only needed when both keys are set: gemini | anthropic
# HUMANISER_PROVIDER=gemini

# Model override. The default is the provider's "latest" alias, which does not
# go stale. Ask the running app for what your key can reach: curl /api/models
# GEMINI_MODEL=gemini-flash-latest
# ANTHROPIC_MODEL=claude-opus-5

# ---- Public deployment ----
# REQUIRED if this server is reachable from the internet and a key is set.
# Without it, anyone who finds the URL can spend your API credit.
HUMANISER_ACCESS_CODE=

# Networking. HOST=0.0.0.0 accepts outside connections; leave it alone locally.
PORT=8787
# HOST=0.0.0.0
# Set to 1 only when a load balancer is genuinely in front: the header it reads
# is easy to forge, and trusting it without one defeats rate limiting.
# TRUST_PROXY=1

# Per-client hourly limits.
# RATE_LIMIT_CLAUDE=20
# RATE_LIMIT_OFFLINE=240
